generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Customer {
  id           Int           @id @default(autoincrement())
  name         String
  mobile       String        @unique
  orders       Order[]
  transactions Transaction[]
}

model Category {
  id       Int       @id @default(autoincrement())
  name     String
  patterns Pattern[]
}

model Unit {
  id       Int           @id @default(autoincrement())
  name     String
  type     String
  options  String? // JSON string for options
  patterns PatternUnit[]
}

model Pattern {
  id         Int           @id @default(autoincrement())
  categoryId Int
  name       String
  amount     Float
  units      PatternUnit[] // Many-to-Many relation
  category   Category      @relation(fields: [categoryId], references: [id])
  orderItems OrderItem[]
}

model PatternUnit {
  id        Int     @id @default(autoincrement())
  patternId Int
  unitId    Int
  pattern   Pattern @relation(fields: [patternId], references: [id])
  unit      Unit    @relation(fields: [unitId], references: [id])
}

model Order {
  id           Int         @id @default(autoincrement())
  customerId   Int
  customer     Customer    @relation(fields: [customerId], references: [id])
  bookingDate  DateTime
  deliveryDate DateTime
  totalAmount  Float
  paidAmount   Float
  status       String
  orderItems   OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  patternId Int
  quantity  Int
  amount    Float
  units     Json // Stores units & quantity as JSON array [{ unitId, quantity }]
  status    String  @default("pending")
  order     Order   @relation(fields: [orderId], references: [id])
  pattern   Pattern @relation(fields: [patternId], references: [id])
}

model Transaction {
  id              Int      @id @default(autoincrement())
  customerId      Int
  transactionType String
  transactionId   String
  amount          Float
  status          String
  paymentMode     String // "cash", "online"
  customer        Customer @relation(fields: [customerId], references: [id])
}
